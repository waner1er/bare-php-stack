{
    "name": "waner1er/bare-php-stack",
    "description": "Petit framework PHP fait main : routing par attributs, clean architecture, Blade et CLI de génération",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Migrations\\": "migrations/"
        },
        "files": [
            "src/Infrastructure/Utils/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "authors": [
        {
            "name": "waner1er",
            "email": "riveterwan8@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "vlucas/phpdotenv": "^5.6",
        "fakerphp/faker": "^1.24",
        "illuminate/view": "^11.0",
        "illuminate/events": "^11.0",
        "illuminate/filesystem": "^11.0",
        "tracy/tracy": "^2.11"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.92",
        "phpunit/phpunit": "^12"
    }
}
